# Which backend to use: ollama | openai | anthropic | openrouter
PROVIDER=ollama

# Optional: override the provider's default model
# MODEL=qwen3.5:9b

# Required for PROVIDER=openai
# OPENAI_API_KEY=sk-...

# Required for PROVIDER=anthropic
# ANTHROPIC_API_KEY=sk-ant-...

# Required for PROVIDER=openrouter (MODEL uses vendor/model IDs, e.g. anthropic/claude-sonnet-5.5)
# OPENROUTER_API_KEY=sk-or-...

# Optional for PROVIDER=ollama (any OpenAI-compatible server works, e.g. LM Studio)
# OLLAMA_BASE_URL=http://localhost:11434/v1
